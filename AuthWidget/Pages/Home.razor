@page "/"

@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Вход — MoshkinA</PageTitle>

<div class="demo-page">
    <h1>MoshkinA</h1>
    <p>Личный кабинет клиента</p>

    <button type="button" class="auth-button" @onclick="Open">
        Открыть окно входа
    </button>
</div>

@if (isOpen)
{
    <div class="auth-overlay">
        <section class="auth-window"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="auth-title">

            <button type="button"
                    class="auth-close"
                    aria-label="Закрыть окно"
                    @onclick="Close">
                ×
            </button>

            <h2 id="auth-title">Вход в личный кабинет</h2>
            <p>Введите логин и пароль</p>

            <form @onsubmit="Submit" @onsubmit:preventDefault>
                <label for="auth-login">Логин</label>
                <input id="auth-login"
                       type="text"
                       @bind="login"
                       autocomplete="username"
                       required />

                <label for="auth-password">Пароль</label>
                <input id="auth-password"
                       type="password"
                       @bind="password"
                       autocomplete="current-password"
                       required />

                <button type="submit"
                        class="auth-button"
                        disabled="@isSubmitting">
                    @(isSubmitting ? "Переход в личный кабинет…" : "Войти")
                </button>
                
            </form>

            @if (!string.IsNullOrEmpty(message))
            {
                <p class="auth-message" role="status">@message</p>
            }

            <p class="auth-note">
                Пример работв
            </p>
        </section>
    </div>
}

@code {
    private bool isOpen = true;
    private bool isSubmitting = false;
    private string login = "";
    private string password = "";
    private string message = "";

    private void Open()
    {
        login = "";
        password = "";
        message = "";
        isSubmitting = false;
        isOpen = true;
    }

    private void Close()
    {
        if (isSubmitting) return;

        password = "";
        isOpen = false;
    }

    private async Task Submit()
    {
        if (isSubmitting) return;

        if (string.IsNullOrWhiteSpace(login) ||
            string.IsNullOrWhiteSpace(password))
        {
            message = "Заполните логин и пароль.";
            return;
        }

        isSubmitting = true;
        message = "Вход успешно завершен";
        password = "";

        try
        {
            StateHasChanged();

            await Task.Delay(1500);

            await JS.InvokeVoidAsync("authBridge.completeDemoLogin");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}